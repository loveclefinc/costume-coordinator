{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["./shared/*"]
    }
  },
  "include": ["src", "vite.config.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "app",
    "components",
    "constants",
    "hooks",
    "lib",
    "server",
    "tests",
    "drizzle",
    // Legacy React Native / Expo utilities are not imported by the current Vite app.
    "src/utils/advanced-recommendation.ts",
    "src/utils/costume-statistics.ts",
    "src/utils/data-migration.ts",
    "src/utils/event-history.ts",
    "src/utils/firebase-sync.ts",
    "src/utils/i18n.ts",
    "src/utils/image-recognition.ts",
    "src/utils/offline-sync.ts",
    "src/utils/participant-sync.ts",
    "src/utils/pdf-generator.ts"
  ]
}
